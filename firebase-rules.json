            "nota":       { ".validate": "newData.isString() && newData.val().length < 300" },
            "creado":     { ".validate": "newData.isNumber()" },
            "items": {
              ".validate": "newData.hasChildren() && !newData.hasChild('60')",
              "$item": {
                ".validate": "newData.hasChildren(['nombre', 'cantidad'])",
                "cantidad": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 50" },
                "precio":   { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1000" },
                "nombre":   { ".validate": "newData.isString() && newData.val().length < 80" },
                "platoId":  { ".validate": "newData.isString() && newData.val().length < 40" },
                "$otro":    { ".validate": false }
              }
            },
            "estado": {
              ".write": "auth != null && (auth.uid == 'fbdIzi6tOwhwJwQR6xY0MLUz4UE3' || auth.uid == 'YHeMmcUbMFdsPQrIcvT561FDunt1' || auth.uid == '0elTDMQYcHSZYZHHyZ4i3RFPQEo1') && data.val() == 'pendiente'",
              ".validate": "newData.isString() && ((!data.exists() && newData.val() == 'pendiente') || (data.val() == 'pendiente' && (newData.val() == 'rechazado' || (newData.val() == 'aceptado' && data.parent().child('creado').val() > now - 10800000))))"
            },
            "resuelto": {
              ".write": "auth != null && (auth.uid == 'fbdIzi6tOwhwJwQR6xY0MLUz4UE3' || auth.uid == 'YHeMmcUbMFdsPQrIcvT561FDunt1' || auth.uid == '0elTDMQYcHSZYZHHyZ4i3RFPQEo1') && data.parent().child('estado').val() == 'pendiente'",
              ".validate": "newData.val() == now && newData.parent().child('estado').val() != 'pendiente'"
            },
            "por": {
              ".write": "auth != null && (auth.uid == 'fbdIzi6tOwhwJwQR6xY0MLUz4UE3' || auth.uid == 'YHeMmcUbMFdsPQrIcvT561FDunt1' || auth.uid == '0elTDMQYcHSZYZHHyZ4i3RFPQEo1') && data.parent().child('estado').val() == 'pendiente'",
              ".validate": "newData.isString() && newData.val() == auth.token.email"
            },
            "toma": {
              ".write": "auth != null && (auth.uid == 'fbdIzi6tOwhwJwQR6xY0MLUz4UE3' || auth.uid == 'YHeMmcUbMFdsPQrIcvT561FDunt1' || auth.uid == '0elTDMQYcHSZYZHHyZ4i3RFPQEo1') && data.parent().child('estado').val() == 'pendiente'",
              ".validate": "newData.isString() && newData.val().length < 30"
            },
            "$otro": { ".validate": false }
          }
        }
      }
    },
    
    "avisos": {
      ".read": "auth != null && auth.uid == 'fbdIzi6tOwhwJwQR6xY0MLUz4UE3'",

      "$rol": {
        "$aparato": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['endpoint', 'p256dh', 'auth', 'creado'])",

          "endpoint": {
            ".validate": "newData.isString() && newData.val().length < 600 && newData.val().beginsWith('https://')"
          },
          "p256dh":  { ".validate": "newData.isString() && newData.val().length < 200" },
          "auth":    { ".validate": "newData.isString() && newData.val().length < 100" },
          "rol":     { ".validate": "newData.isString() && newData.val().length < 20" },
          "correo":  { ".validate": "newData.isString() && newData.val().length < 90" },
          "aparato": { ".validate": "newData.isString() && newData.val().length < 60" },
          "creado":  { ".validate": "newData.isNumber()" },
          "$otro": { ".validate": false }
        }
      }
    },

    "pedidos": {
      ".read": "auth != null && auth.uid == 'fbdIzi6tOwhwJwQR6xY0MLUz4UE3'",
      ".write": "auth != null && auth.uid == 'fbdIzi6tOwhwJwQR6xY0MLUz4UE3'"
    },

    "vistas": {
      ".read": "auth != null && auth.uid == 'fbdIzi6tOwhwJwQR6xY0MLUz4UE3'",
      ".write": "auth != null && auth.uid == 'fbdIzi6tOwhwJwQR6xY0MLUz4UE3'",
      "$vista": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['cuando']) && (newData.hasChild('plato') || newData.hasChild('platos'))",
        "plato": {
          ".validate": "newData.isString() && newData.val().length < 20"
        },
        "cuando": {
          ".validate": "newData.isNumber()"
        }
      }
    },

    "$otro": {
      ".read": false,
      ".write": false
    }
  }
}
